{
  "name": "secure-exam-browser-system",
  "version": "1.0.0",
  "private": true,
  "description": "Independent, production-grade Secure Examination System for Windows and cross-platform clients.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm --workspace=@seb/core run build",
    "build:platform": "npm --workspace=@seb/platform-windows run build",
    "build:server": "npm --workspace=@seb/server run build",
    "build:config": "npm --workspace=@seb/config-tool run build",
    "build:client": "npm --workspace=@seb/client run build",
    "build": "npm run build:core && npm run build:platform && npm run build:server && npm run build:config && npm run build:client",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start:server": "npm --workspace=@seb/server run start",
    "start:client": "npm --workspace=@seb/client run start",
    "start:config-tool": "npm --workspace=@seb/config-tool run start",
    "start:admin": "npm --workspace=@seb/admin-dashboard run dev"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^9.0.0",
    "commander": "^12.0.0",
    "electron": "^28.2.0",
    "fastify": "^4.26.1",
    "koffi": "^2.8.11",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
