{
  "name": "@seb/client",
  "version": "1.0.0",
  "description": "Secure Exam Browser Native Windows Desktop Application",
  "main": "dist/main/index.js",
  "author": "COdeNbrowser Team",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:exe": "electron-builder --win --x64",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@seb/core": "*",
    "@seb/platform-windows": "*",
    "jimp": "^1.6.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "28.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "build": {
    "appId": "com.codenbrowser.app",
    "productName": "COdeNbrowser",
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "src/preload/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true
    },
    "directories": {
      "output": "../../packages/server/public/downloads"
    }
  }
}
